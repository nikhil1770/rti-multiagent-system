# Copy to .env and fill in. NEVER commit .env.

# --- LLM (Google Gemini free tier) ---
# One or more keys; extra keys are used as quota failover.
GOOGLE_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY1=second-account-key
# GOOGLE_API_KEY2=third-account-key
DRAFTING_MODEL=gemini-2.5-pro
LIGHT_MODEL=gemini-2.5-flash

# --- Database (LangGraph checkpointer) ---
POSTGRES_URL=postgresql://rti:rti@localhost:5432/rti

# --- Vector store ---
CHROMA_PATH=./data/chroma

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Optional tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
